;; Core wiring shared by every chapter.

;; Spawn the persistent multiplayer controller alongside obj_time.
@append gml_Object_obj_time_Create_0
if (!instance_exists(obj_mp_controller))
    instance_create(0, 0, obj_mp_controller);

;; Input replication / blocking happens right after the game samples input.
@prepend gml_Object_obj_time_Step_1
mp_before_input();

@append gml_Object_obj_time_Step_1
mp_after_input();

;; Player character sprite swap.
@find gml_Object_obj_mainchara_Draw_0
draw_self();
@with
mp_draw_mainchara(0);
@end

;; Chapter 4 draws Kris with draw_sprite_ext (tower shake offset) instead of draw_self().
#chapters 4
@find gml_Object_obj_mainchara_Draw_0
draw_sprite_ext(sprite_index, image_index, x + tower_shake_xoffset, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
@with
mp_draw_mainchara(tower_shake_xoffset);
@end
#chapters all

;; Chapter 5's "weird mode" draws Kris with draw_sprite.
#chapters 5
@find gml_Object_obj_mainchara_Draw_0
draw_sprite(sprite_index, image_index, floor(_weird_mode_xx), _weird_mode_yy);
@with
mp_draw_mainchara_plain(floor(_weird_mode_xx), _weird_mode_yy);
@end
#chapters all

;; The other players' SOULs are drawn over the battle box.
@append gml_Object_obj_heart_Draw_0
mp_heart_draw_others();

;; A spectating player's hidden SOUL earns no TP from grazing and doesn't shorten the turn.
@prepend gml_Object_obj_grazebox_Collision_obj_collidebullet
if (mp_spectating())
    exit;

@prepend? gml_Object_obj_grazebox_Collision_obj_orangeheart_bullet
if (mp_spectating())
    exit;

;; Chapter 1's snd_init does not record the song's file name (Chapter 2+ does): the music sync needs it.
#chapters 1
@find gml_GlobalScript_snd_init
    _astream.mystream = _mystream;
@with
    _astream.mystream = _mystream;
    _astream.songname = arg0;
@end
#chapters all

;; Battle lifecycle.
@append gml_Object_obj_battlecontroller_Create_0
mp_battle_created();

;; Turn barrier before every new menu turn.
@regex gml_GlobalScript_scr_mnendturn
(function scr_mnendturn\([^)]*\)\s*\{)
@with
$1
    if (!mp_turn_gate())
        return;
@end

;; Identical random numbers for the attack phase everywhere.
@regex gml_GlobalScript_scr_endturn
(function scr_endturn\([^)]*\)\s*\{)
@with
$1
    mp_battle_seed(1);
@end

;; Bullets only hurt the hero you play.
@regex gml_GlobalScript_scr_damage
(function scr_damage\([^)]*\)\s*\{)
@with
$1
    if (mp_battle_on())
    {
        target = mp_damage_target(target);
        if (target < 0)
        {
            mp_damage_spectator();
            return;
        }
    }
    else if (mp_overworld_all_down())
    {
        scr_gameover();
        return;
    }
    else if (mp_spec_on())
        return; // (watching someone on the map: my hidden character stands where they are)
@end

;; Attack timing: everyone presses for their own hero.
@prepend gml_Object_obj_attackpress_Draw_0
mp_qte_apply();

@append gml_Object_obj_attackpress_Create_0
mp_qte_done();

@find gml_Object_obj_attackpress_Draw_0
if ((boltframe[i] - boltx) < -5)
@with
if ((boltframe[i] - boltx) < -5 && mp_qte_canexpire(boltchar[i]))
@end

@find gml_GlobalScript_scr_boltcheck_onebutton
if (boltalive[i] == 1)
@with
if (boltalive[i] == 1 && mp_qte_mine(boltchar[i]))
@end

@regex gml_GlobalScript_scr_boltcheck
(function scr_boltcheck\(arg0\)\s*\{)
@with
$1
    if (!mp_qte_mine(arg0))
        return;
@end

@prepend gml_Object_obj_attackpress_Other_11
mp_qte_report(target, points[target]);

;; Dialogue choices in shared cutscenes follow the leader.
@prepend gml_Object_obj_choicer_neo_Other_10
if (canchoose == 1 && choiced == 0)
{
    if (mp_vote_cast(mychoice))
        exit;
    mp_choice_made(mychoice);
}

@prepend gml_Object_obj_choicer_neo_Step_0
mp_choice_step();

;; Loading a save must not broadcast that save's flags.
@regex gml_GlobalScript_scr_load
(function scr_load\([^)]*\)\s*\{)
@with
$1
    mp_gameover_continued();
    if (mp_wipe_return())
        return;
    mp_on_save_loaded();
@end

;; A new file resets the story state: that must not be broadcast either.
@regex gml_GlobalScript_scr_gamestart
(function scr_gamestart\([^)]*\)\s*\{)
@with
$1
    mp_on_game_reset();
@end

;; A party wipe in one game is a party wipe for everyone in that battle.
@regex gml_GlobalScript_scr_gameover
(function scr_gameover\([^)]*\)\s*\{)
@with
$1
    mp_on_gameover();
@end

;; Chapter 5 followers already have a Draw event (chapters 1-4 get gml_Object_obj_caterpillarchara_Draw_0).
#chapters 5
@find gml_Object_obj_caterpillarchara_Draw_0
draw_self();
@with
mp_draw_caterpillar();
@end
#chapters all

;; Chapter 3 board: pieces are drawn as the players' characters (scr_mp_board, gml/ch3).
#chapters 3
@find gml_Object_obj_mainchara_board_Draw_0
draw_sprite_ext(sprite_index, image_index, round(x / 2) * 2, round(y / 2) * 2, image_xscale, image_yscale, image_angle, image_blend, image_alpha);
@with
mp_board_draw_piece(round(x / 2) * 2, round(y / 2) * 2);
@end

@find gml_Object_obj_mainchara_board_Draw_0
draw_self();
@with
mp_board_draw_piece(x, y);
@end
#chapters all

;; Chapter 4: cutscene floor shadows copy their target's sprite; never draw a missing one.
#chapters 4
@prepend gml_Object_obj_floorshadow_Draw_0
if (instance_exists(target) && !sprite_exists(target.sprite_index))
    exit;
#chapters all

;; C menu (status and equipment pages): the hero I play in Kris's place is named after my character
;; (and my character's own slot "Kris"), like the figures on the map.
@regex gml_Object_obj_darkcontroller_Draw_0
string_hash_to_newline\(global\.charname\[charcoord\]\)
@with
string_hash_to_newline(mp_menu_charname(charcoord))
@end

;; Puzzles together (Chapter 1 pushable blocks): a push is shared with everyone in the room.
#chapters 1
@find gml_Object_obj_pushableblock_Other_10
        movecourse = 1;
        movetimer = 0;
@with
        movecourse = 1;
        movetimer = 0;
        mp_puz_pushed();
@end

@prepend gml_Object_obj_pushableblock_Step_0
mp_puz_block_step();

@append gml_Object_obj_pushableblock_Create_0
mp_puz_block_create();

@prepend gml_Object_obj_darkeyepuzzle_switch_Other_10
mp_puz_switch_used();

@prepend gml_Object_obj_glowtilepuzz_Other_10
mp_puz_switch_used();

;; Chapter 2: the traffic lights' switches are pressed in every game in the room; the alley's floor
;; switch is held down by a friend's figure standing on it too.
#chapters 2
@prepend gml_Object_obj_traffic_switch_Other_10
mp_puz_switch_used();

@regex gml_Object_obj_alleySwitch_Step_0
place_meeting\(x, y, obj_mainchara\)
@with
(place_meeting(x, y, obj_mainchara) || mp_puz_ghost_here())
@end

;; Chapter 3: the glowing tiles' hourglass (as in Chapter 1; the tiles themselves are pressed by the
;; others' figures in every chapter).
#chapters 3
@prepend gml_Object_obj_glowtilepuzz_Other_10
mp_puz_switch_used();

;; Chapters 4 and 5: floor switches are held down by a friend standing on them too.
#chapters 4,5
@regex gml_Object_obj_floorswitch_Step_0
place_meeting\(x, y, obj_mainchara\)
@with
(place_meeting(x, y, obj_mainchara) || mp_puz_ghost_here())
@end

;; Chapter 4 bookshelf puzzle: a shelf a friend slid with a piano slides in my game too (it follows
;; its story flags, scr_mp_shelf).
#chapters 4
@find gml_Object_obj_bookshelf_moveable2x2_Step_0
        global.flag[yflag] = y;
    }
}
@with
        global.flag[yflag] = y;
    }
}
mp_shelf_follow();
@end

@append gml_Object_obj_dw_church_bookshelfpuzzle_Step_0
mp_shelf_test();

;; Chapter 5 pushable blocks (the garden): pushed in every game in the room, like Chapter 1's.
#chapters 5
@find gml_Object_obj_pushable_block_Other_10
        movecourse = 1;
        movetimer = 0;
@with
        movecourse = 1;
        movetimer = 0;
        mp_puz_pushed();
@end

@prepend gml_Object_obj_pushable_block_Step_0
mp_puz_block_step();

@append gml_Object_obj_pushable_block_Create_0
mp_puz_block_create();
#chapters 1

;; The suits puzzles' buttons (spade, diamond, swap: room_field_secret1, the forest's clover and suits
;; rooms): a press in one game presses the same button in every game in the room.
@prepend gml_Object_obj_suitspuzz_button_Other_10
mp_puz_switch_used();
#chapters all

;; Noclip (F6): the player's wall checks find no walls while it is on.
@regex gml_Object_obj_mainchara_Step_0
place_meeting\(([^()]*), obj_solidblock\)
@with
(!mp_noclip_on() && place_meeting($1, obj_solidblock))
@end

;; A story event played again (rewind, story tool, or another player's copy) must not put a party
;; member in the party twice.
@regex gml_GlobalScript_scr_getchar
(function scr_getchar\(arg0\)\s*\{)
@with
$1
    if (mp_party_dup(arg0))
        return;
@end

;; A touched overworld enemy is removed in every player's game, not only the toucher's.
#chapters 1
@prepend gml_Object_obj_chaseenemy_Other_10
mp_enemy_touched();
#chapters 2,3,4,5
@prepend gml_Object_obj_overworldenemy_parent_Other_10
mp_enemy_touched();
#chapters all

;; Encounters start at the same moment in every game: everyone waits just before the "!" horn.
@prepend gml_Object_obj_testoverworldenemy_Step_0
if (con == 1 && !mp_enc_gate())
    exit;

;; Chapter 4's boss fights (Titans, the pumpkin, the statue, Elnina & Lanino's rematch) set the whole
;; party themselves as they start (scr_setchar there): they're fought like story battles, with the
;; game's party in every game, not one hero per player (their enemies need Ralsei and Susie).
#chapters 4
@append gml_Object_obj_testoverworldenemy_Other_10
mp_enc_game_party(global.encounterno == 174 || global.encounterno == 175 || global.encounterno == 176 || global.encounterno == 177 || global.encounterno == 178 || global.encounterno == 186);
#chapters all

;; Noelle's house (chapter 4): the basement overlay follows the heart and Noelle's light, which the
;; story scene creates. A player who only watched that scene (it played in another game) has the
;; overlay but not what it follows: nothing to follow, nothing drawn, instead of a crash.
#chapters 4
@prepend gml_Object_obj_noellehouse_basement_overlay_Draw_0
if (heart_target != -4 && !instance_exists(heart_target))
    heart_target = -4;
if (noelle_light_target != -4 && !instance_exists(noelle_light_target))
    noelle_light_target = -4;
#chapters all

;; Chapter 1's text box only gets its face (myface) a frame after it is made. Closed sooner (a player
;; watching another's cutscene gets the next text box while the last one is still that new), its
;; Destroy read the face that was not there yet and crashed (room_cc_prisonlancer).
#chapters 1
@prepend gml_Object_obj_dialoguer_Destroy_0
if (!variable_instance_exists(id, "myface"))
    myface = -4;
#chapters all

;; A fight's own party: the intro shows who is really in it.
@append gml_Object_obj_encounterbasic_Create_0
mp_intro_markers();

;; ...and the walk back to the party at the end shows the same heroes.
@append gml_Object_obj_endbattle_Create_0
mp_end_markers();

;; Cutscene mirror (scr_mp_mirror): the leader's text boxes open in the followers' games...
@append gml_Object_obj_dialoguer_Other_10
mp_mirror_dialoguer_made();

;; ...and the sounds of the leader's scene play there too.
#chapters 1,2
@regex gml_GlobalScript_snd_play
(function snd_play\(arg0\)\s*\{)
@with
$1
    mp_mirror_snd(arg0, 1, 1);
@end
#chapters 3,4,5
@regex gml_GlobalScript_snd_play
(function snd_play\(arg0, arg1 = 1, arg2 = 1\)\s*\{)
@with
$1
    mp_mirror_snd(arg0, arg1, arg2);
@end
#chapters all

;; WASD works as the arrow keys (mp_wasd): next to each of the game's checks of its key setting.
@regex gml_Object_obj_time_Step_1
\b(keyboard_check|sunkus_kb_check)\(global\.input_k\[(\w+)\]\)
@with
($1(global.input_k[$2]) || mp_wasd($2))
@end

;; A client saves: the host saves too, so the host's file (the shared story) is never behind.
@regex gml_GlobalScript_scr_save
(function scr_save\([^)]*\)\s*\{)
@with
$1
    mp_on_save();
@end

;; TP lost in a fight: the bar flashes and shakes.
@append gml_Object_obj_tensionbar_Draw_0
mp_tp_bar_fx();

;; Multiplayer fights: every player dodges with their own SOUL, so the game's "this hero is the
;; target" look (the other heroes darkened) means nothing: no hero is darkened.
@append gml_Object_obj_darkener_Draw_0
mp_no_target_look();

;; Map hazards (the SOUL shows on the map): the game draws Kris's outline over the player. A
;; player who is someone else gets their own character's outline instead. ("s[p]r": the patcher's
;; asset check would read "spr_kris" as a sprite name.)
@regex gml_Object_obj_mainchara_Draw_0
draw_sprite_ext\((s[p]r_kris[durl]_heart|s[p]r_krisd_slide_heart),
@with
mp_draw_ow_heart($1,
@end

;; Out-of-battle hits go to the character the player plays (in their own game).
@prepend gml_Object_obj_overworldbulletparent_Other_15
if (active == 1)
    mp_ow_hit_target();

;; The hallway mirror at home (Light World) reflects the character I play, not Kris.
@append? gml_Object_obj_hallway_mirror_Step_2
mp_mirror_reflect_me();

;; Chapter 1 classroom: the room built again at plot 2 (between Alphys's talk and Susie coming in:
;; a player joining, a watched scene's room put back) had no Alphys and no wall at the door, which
;; only the scene itself makes. It is put back as the scene leaves it.
#chapters 1
@append gml_Object_obj_classscene_Create_0
mp_classroom_restore();
#chapters all

;; The host's "players' heroes only" setting: story fights drop the heroes nobody plays, before the
;; battle makes them.
@prepend gml_Object_obj_battlecontroller_Create_0
mp_noai_party();

;; Climbing (Chapters 4-5): I climb as the character I play (Susie and Ralsei have climbing sprites).
#chapters 4,5
@regex gml_Object_obj_climb_kris_Draw_0
draw_sprite_ext\(sprite_index, image_index, x \+ drawx,
@with
draw_sprite_ext(mp_climb_sprite(sprite_index), image_index, x + drawx,
@end
#chapters all

;; ...also on the rotating towers, where the tower draws the climber.
#chapters 4,5
@regex gml_Object_obj_rotating_kris_controller_new_Draw_0
draw_sprite_ext\((o[b]j_climb_kris\.sprite_index),
@with
draw_sprite_ext(mp_climb_sprite($1),
@end
#chapters all
