// DELTARUNE Multiplayer - cutscene mirror.
//
// A shared story cutscene plays only in the leader's game (whoever started it). Everyone else
// (sstate 5) sees what the leader's game shows:
//  - their own room is switched off (instances deactivated: nothing in it runs or draws), so the
//    room's own copy of the cutscene never starts; its background and tiles still show;
//  - the leader sends, every frame, the camera and the sprites on screen in drawing order
//    (types 70-75, unreliable, up to 40 sprites each, with their depth); obj_mp_mirror draws
//    them, a second one those behind the room's tiles;
//  - text boxes are real ones: the leader sends the box's lines, face and voice when it opens one
//    (77 lines, 78 show) and the follower opens the same box itself (same font, face, typing
//    sound); the leader turns its pages for everyone (mp_dlg_input) once it has finished typing
//    on every screen;
//  - sounds the leader's scene plays are played too (76), and the leader's music;
//  - at the end (type 31) the follower goes back to where it was pulled from (a scene that ended
//    where it began) or is moved to where the leader ended up (one that moved on), and its room is
//    built again, with the story changes the scene made.
// What each object draws comes from scr_mp_mirrorinfo, generated by the patcher (MirrorInfo.cs).

function mp_mirror_init()
{
    global.mp_mir_list = ds_list_create();      // my room's instances, switched off while mirroring
    global.mp_mir_hdr = -1;                     // [frame, room, cam x, cam y, chunk count, time]
    global.mp_mir_chunks = array_create(6, -1); // per chunk: [frame, sprites]
    global.mp_mir_frame = -1;                   // the newest whole frame: [frame, room, sprites]
    global.mp_mir_seq = 0;
    global.mp_mir_lines = array_create(64, "");
    global.mp_mir_grid = ds_grid_create(10, 64);
    global.mp_mir_choice = -1;
    global.mp_mir_choice_t = 0;
    global.mp_mir_frozen_room = -1;
    global.mp_mir_after_room = -1;              // where a mirrored scene just ended...
    global.mp_mir_after_until = 0;              // ...and until when its own copy mustn't start there
    global.mp_mir_end_at = -1;                  // [x, y] where the leader was when it ended there
    global.mp_mir_home = -1;                    // [room, x, y, darkzone] I was pulled from
    global.mp_mir_start_room = -1;              // the room the mirrored scene began in
    mp_mirror_info_init();
    mp_mirror_keep_init();
    global.mp_mir_klog = 0;
    global.mp_mir_extra = [];                   // sprites drawn by hand in my scene's objects (mp_mir_dse)
    global.mp_mir_pix = asset_get_index("spr_pixel_white"); // a small white sprite (2x2 in Chapter 5): rectangles go as it, stretched
    // Text boxes are opened by the followers themselves; the mod's own objects are never sent.
    var never = ["obj_writer", "obj_dialoguer", "obj_face", "obj_smallface", "obj_choicer_neo", "obj_mp_controller", "obj_mp_ghost", "obj_mp_mirror"];
    for (var i = 0; i < array_length(never); i++)
    {
        var o = asset_get_index(never[i]);
        if (o >= 0 && o < array_length(global.mp_mi_kind))
            global.mp_mi_kind[o] = 2;
    }
}

function mp_mirror_reset()
{
    global.mp_mir_hdr = -1;
    for (var i = 0; i < 6; i++)
        global.mp_mir_chunks[i] = -1;
    global.mp_mir_frame = -1;
    global.mp_mir_choice = -1;
    ds_list_clear(global.mp_mir_list);
    global.mp_mir_frozen_room = -1;
}

// ---------------------------------------------------------------- leader

// obj_mp_controller End Step: the sprites on my screen, for the players mirroring my cutscene.
function mp_mirror_lead_tick()
{
    if (!mp_on() || global.mp_sstate != 1 || mp_player_count() < 2 || mp_in_battle_scene())
    {
        global.mp_mir_extra = [];
        return;
    }
    var cam = view_camera[0];
    var vx = camera_get_view_x(cam);
    var vy = camera_get_view_y(cam);
    var vw = camera_get_view_width(cam);
    var vh = camera_get_view_height(cam);
    var g = global.mp_mir_grid;
    if (ds_grid_height(g) < 300)
        ds_grid_resize(g, 10, 300);
    var n = 0;
    var kinds = global.mp_mi_kind;
    var evals = global.mp_mi_eval;
    var nk = array_length(kinds);
    // (Test token mirdump: every 10 s, the visible objects that draw on their own and send nothing.)
    if (global.mp_test != "" && (global.mp_mir_seq mod 600) == 0 && mp_test_has("mirdump"))
    {
        var dl = "";
        with (all)
        {
            var oi0 = object_index;
            if (visible && oi0 >= 0 && oi0 < nk && kinds[oi0] == 2 && !mp_mirror_kept(oi0) && !persistent && !variable_instance_exists(id, "mp_mir_hand"))
                dl += object_get_name(oi0) + "@" + string(depth) + " ";
        }
        mp_log("mirdump: " + dl);
        // (mirdumpall: every visible object, its kind and depth, and the tiles' depth.)
        if (mp_test_has("mirdumpall"))
        {
            var da = "";
            with (all)
            {
                if (visible && !persistent)
                    da += object_get_name(object_index) + ":" + string(object_index < nk ? kinds[object_index] : -1) + "@" + string(depth) + (sprite_index >= 0 ? ":" + sprite_get_name(sprite_index) + "a" + string(image_alpha) : "") + " ";
            }
            mp_log("mirdumpall: cut " + string(mp_mirror_tile_cut()) + " " + da);
            mp_log("mirdumpall layers: " + mp_mirror_layer_dump());
        }
    }
    with (all)
    {
        if (visible && n < 300)
        {
            var oi = object_index;
            var k = 2;
            if (oi >= 0 && oi < nk)
                k = kinds[oi];
            // (A kept backdrop draws itself in the watchers' games; an object drawing by hand sends
            // what it draws, mp_mir_dse.)
            if (k != 2 && (mp_mirror_kept(oi) || variable_instance_exists(id, "mp_mir_hand")))
                k = 2;
            var r = -1;
            if (k == 3)
                r = script_execute(evals[oi]);
            else if (k != 2 && sprite_index >= 0)
                r = [sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha];
            // (A one-colour silhouette, Chapter 5's coloured afterimages, obj_marker_fog: its
            // colour, and 10000 added to the angle as the mark.)
            if (is_array(r) && (oi == global.mp_mir_fogobj || oi == global.mp_mir_fogobj2) && variable_instance_exists(id, "color"))
            {
                r[7] = color;
                r[6] += 10000;
            }
            if (is_array(r) && sprite_exists(r[0]) && r[8] > 0)
            {
                var big = max(sprite_get_width(r[0]) * abs(r[4]), sprite_get_height(r[0]) * abs(r[5]));
                if ((r[2] + big) >= vx && (r[2] - big) <= (vx + vw) && (r[3] + big) >= vy && (r[3] - big) <= (vy + vh))
                {
                    var nf = sprite_get_number(r[0]);
                    ds_grid_set(g, 0, n, depth);
                    ds_grid_set(g, 1, n, r[0]);
                    ds_grid_set(g, 2, n, nf > 0 ? (floor(r[1]) mod nf) : 0);
                    ds_grid_set(g, 3, n, r[2]);
                    ds_grid_set(g, 4, n, r[3]);
                    ds_grid_set(g, 5, n, r[4]);
                    ds_grid_set(g, 6, n, r[5]);
                    ds_grid_set(g, 7, n, r[6]);
                    ds_grid_set(g, 8, n, r[7]);
                    ds_grid_set(g, 9, n, r[8]);
                    n += 1;
                }
            }
        }
    }
    // The sprites a scene's object drew by hand last frame (mp_mir_dse), at that object's depth.
    var ex = global.mp_mir_extra;
    for (var e = 0; e < array_length(ex) && n < 300; e++)
    {
        var r2 = ex[e];
        if (!sprite_exists(r2[1]) || r2[9] <= 0)
            continue;
        var big2 = max(sprite_get_width(r2[1]) * abs(r2[5]), sprite_get_height(r2[1]) * abs(r2[6]));
        if ((r2[3] + big2) < vx || (r2[3] - big2) > (vx + vw) || (r2[4] + big2) < vy || (r2[4] - big2) > (vy + vh))
            continue;
        var nf2 = sprite_get_number(r2[1]);
        ds_grid_set(g, 0, n, r2[0]);
        ds_grid_set(g, 1, n, r2[1]);
        ds_grid_set(g, 2, n, nf2 > 0 ? (((floor(r2[2]) mod nf2) + nf2) mod nf2) : 0);
        for (var q = 3; q < 10; q++)
            ds_grid_set(g, q, n, r2[q]);
        n += 1;
    }
    global.mp_mir_extra = [];
    // Drawing order: deepest first.
    if (n > 1)
    {
        ds_grid_resize(g, 10, n);
        ds_grid_sort(g, 0, false);
    }
    global.mp_mir_seq += 1;
    mp_mirror_layers_send();
    mp_mirror_keep_send();
    var per = 40; // (25 bytes a sprite: a datagram stays near 1 KB)
    var chunks = clamp(ceil(n / per), 1, 6);
    // Past 120 sprites (more than 3 datagrams), a frame goes every other frame (the link sends 4
    // datagrams a frame). Always all of a frame's parts: the others only draw whole frames.
    if (chunks > 3 && (global.mp_mir_seq mod 2) == 1)
        return;
    for (var c = 0; c < chunks; c++)
    {
        mp_begin(70 + c);
        mp_wu32(global.mp_mir_seq);
        mp_wu16(room);
        mp_ws16(vx);
        mp_ws16(vy);
        mp_wu8(c);
        mp_wu8(chunks);
        var a = c * per;
        var b = min(n, a + per);
        mp_wu8(max(0, b - a));
        for (var i = a; i < b; i++)
        {
            mp_wu16(ds_grid_get(g, 1, i));
            mp_wu8(ds_grid_get(g, 2, i));
            mp_ws16(ds_grid_get(g, 3, i));
            mp_ws16(ds_grid_get(g, 4, i));
            buffer_write(global.mp_msg, buffer_f32, ds_grid_get(g, 5, i));
            buffer_write(global.mp_msg, buffer_f32, ds_grid_get(g, 6, i));
            mp_ws16(ds_grid_get(g, 7, i));
            var col = ds_grid_get(g, 8, i);
            mp_wu8(colour_get_red(col));
            mp_wu8(colour_get_green(col));
            mp_wu8(colour_get_blue(col));
            mp_wu8(ds_grid_get(g, 9, i) * 255);
            buffer_write(global.mp_msg, buffer_s32, clamp(ds_grid_get(g, 0, i), -2000000000, 2000000000));
        }
        mp_send();
    }
}

// Appended to obj_dialoguer's User Event 0, which has just made its writer.
function mp_mirror_dialoguer_made()
{
    if (!variable_global_exists("mp_inited") || !mp_on() || global.mp_sstate != 1 || mp_player_count() < 2)
        return;
    if (instance_exists(writer))
        mp_mirror_send_dialogue(writer, side);
}

// Sends the text box writer w is showing (from the page it's on) to the followers.
function mp_mirror_send_dialogue(w, sd)
{
    var lines = 0;
    var start = w.msgno;
    for (var i = start; i < 100 && lines < 60; i++)
    {
        var s = w.nstring[i];
        if (!is_string(s))
            break;
        mp_begin(77);
        mp_wu8(lines);
        buffer_write(global.mp_msg, buffer_string, string_copy(s, 1, 1000));
        mp_send();
        lines += 1;
        // "/%" (wait, then close) or "%%" (close) ends the box; a lone "%" goes straight on to the
        // next page (a face change between two speakers is a page of its own like that).
        if (string_pos("/%", s) > 0 || string_pos("%%", s) > 0)
            break;
    }
    mp_begin(78);
    mp_wu16(global.mp_dlg_n);
    mp_wu8(sd);
    mp_wval(global.fc);
    mp_wval(global.fe);
    mp_wval(global.typer);
    mp_wu8(lines);
    mp_send();
    mp_log("mirror: sent a text box, " + string(lines) + " pages from page " + string(global.mp_dlg_n));
}

// Prepended to snd_play: sounds of my cutscene play for the followers too (not the text box's
// typing, which their own text box makes).
function mp_mirror_snd(snd, vol, pitch)
{
    if (!variable_global_exists("mp_inited") || !mp_on() || global.mp_sstate != 1 || mp_player_count() < 2)
        return;
    // (By name: whichever object plays it, a typing voice is snd_text or snd_txt*.)
    var nm = audio_get_name(snd);
    if (string_pos("snd_tx", nm) == 1 || string_pos("snd_text", nm) == 1)
        return;
    mp_begin(76);
    mp_wu16(snd);
    mp_wu8(clamp(vol, 0, 2.5) * 100);
    mp_wu8(clamp(pitch, 0, 2.5) * 100);
    mp_send();
}

// ---------------------------------------------------------------- follower

// Start mirroring `from`'s cutscene, which began in room rm.
function mp_mirror_start(from, rm)
{
    // Where I was before being pulled in: I go back there when the scene ends (mp_mirror_end).
    if (global.mp_sstate != 5)
    {
        global.mp_mir_home = -1;
        if (instance_exists(obj_mainchara) && mp_room_ok(room) && !mp_in_battle_scene())
        {
            var hx = obj_mainchara.x;
            var hy = obj_mainchara.y;
            if (hx > -1000 && hy > -1000 && hx < room_width + 1000 && hy < room_height + 1000)
                global.mp_mir_home = [room, hx, hy, mp_dz()];
        }
        global.mp_mir_start_room = rm;
        // (A scene I watch counts as one I had in its room, unless it is the one my own game just
        // started there: mp_cs_part_next.)
        var prm = rm >= 0 ? rm : room;
        if (!(global.mp_last_cs_room == prm && global.mp_cs_part_room == prm && (current_time - global.mp_last_cs_t) < 3000))
            global.mp_last_cs_part = mp_cs_part_next(prm);
    }
    mp_mirror_reset();
    global.mp_slead = from;
    global.mp_sstate = 5;
    global.mp_idle = 0;
    global.mp_lead_free = 0;
    global.mp_lead_done = 0;
    global.mp_choice_seq = 0;
    global.mp_watch_text = "";
    ds_map_clear(global.mp_choices);
    mp_close_local_dialogue();
    global.interact = 1;
    mp_log("watching " + global.mp_pname[from] + "'s cutscene");
    mp_log("mirror: start, leader " + string(from) + ", room " + room_get_name(rm));
    global.mp_warp_mus = from;
    if (room != rm && mp_room_ok(rm))
    {
        // Only the look of the room matters: it's switched off as soon as it starts.
        global.mp_warp_reenter = 0;
        mp_warp(rm, -99999, -99999, 0);
    }
    else
    {
        mp_mirror_freeze();
        mp_music_follow(from);
    }
    // The leader sends the text box that's open, if any.
    mp_begin(79);
    mp_wu8(from);
    mp_send();
}

// Switches off every instance of my room (the room's own objects, my character, the party).
function mp_mirror_freeze()
{
    ds_list_clear(global.mp_mir_list);
    with (all)
    {
        // (Not the kept scenery: it draws the leader's backdrop here.)
        if (!persistent && string_pos("obj_mp_", object_get_name(object_index)) != 1 && !mp_mirror_kept(object_index))
            ds_list_add(global.mp_mir_list, id);
    }
    for (var i = 0; i < ds_list_size(global.mp_mir_list); i++)
        instance_deactivate_object(ds_list_find_value(global.mp_mir_list, i));
    global.mp_mir_frozen_room = room;
    mp_log("mirror: room " + room_get_name(room) + " switched off (" + string(ds_list_size(global.mp_mir_list)) + " instances)");
}

// mp_sync_tick, while mirroring.
function mp_mirror_follow_tick()
{
    global.interact = 1;
    var ld = global.mp_slead;
    if (ld < 0 || ld >= 8 || !global.mp_pconn[ld])
    {
        mp_log("mirror: leader gone");
        mp_mirror_end(-1, 0, 0, 0, -1);
        return;
    }
    // The leader's scene is over without our hearing the end (or it only concerned their game).
    if ((global.mp_pstate[ld] & 2) == 0)
    {
        if (global.mp_lead_free == 0)
            global.mp_lead_free_t = current_time;
        global.mp_lead_free += 1;
    }
    else
        global.mp_lead_free = 0;
    // (150 frames and at least 3 s of real time: the leader's state comes with its position, which a
    // bad network or a player who just joined may not have had for a moment.)
    if (global.mp_lead_free > 150 && current_time - global.mp_lead_free_t > 3000)
    {
        mp_log("mirror: leader is no longer in a cutscene");
        mp_mirror_end(-1, 0, 0, 0, -1);
        return;
    }
    if (global.mp_warp_pending)
        return;
    // The leader's Light/Dark World (a scene that goes from the castle to the town): what the
    // room's own objects draw depends on it, such as Chapter 5's town colours (drawn at half size
    // in the Light World). My own comes back when the scene is over (mp_mir_home).
    mp_dz_take((global.mp_pstate[ld] & 64) != 0 ? 1 : 0);
    // A room the leader's scene moved to.
    var h = global.mp_mir_hdr;
    if (is_array(h) && h[1] != room && global.mp_warp_delay <= 0 && mp_room_ok(h[1]))
    {
        mp_log("mirror: scene moved to " + room_get_name(h[1]));
        global.mp_warp_reenter = 0;
        mp_warp(h[1], -99999, -99999, 0);
        return;
    }
    // Something of my room still running (it started after the freeze): off with it.
    if (global.mp_mir_frozen_room != room)
        mp_mirror_freeze();
}

// obj_mp_controller Begin Draw time is too late for the view; done in the mirror object's Step.
function mp_mirror_camera()
{
    var h = global.mp_mir_hdr;
    if (global.mp_sstate != 5 || !is_array(h) || h[1] != room)
        return;
    camera_set_view_pos(view_camera[0], h[2], h[3]);
}

function mp_mirror_end(rm, ex, ey, edz, from)
{
    mp_log("mirror: end" + (rm >= 0 ? " in " + room_get_name(rm) : ""));
    with (obj_choicer_neo)
        instance_destroy();
    with (obj_writer)
        instance_destroy();
    with (obj_dialoguer)
        instance_destroy();
    global.interact = 0;
    global.mp_prev_interact = 0;
    global.mp_sstate = 0;
    global.mp_slead = -1;
    global.mp_watch_text = "";
    mp_mirror_reset();
    mp_vars_apply_queue();
    // My room was switched off: it's built again (with the story as the scene left it). If its own
    // copy of the scene starts anyway (the scene's "done" mark is something we don't share, or the
    // story is further on here), it's stopped: mp_mirror_after_check.
    global.mp_warp_reenter = 1;
    global.mp_mir_after_room = rm >= 0 ? rm : room;
    global.mp_mir_after_until = current_time + 8000;
    global.mp_mir_end_at = (rm >= 0 && rm == room && ex > -9999) ? [ex, ey] : -1;
    var home = mp_mirror_home(rm, edz);
    // (A scene that took the party far along this same room, like Chapter 2's ride beside Queen's
    // car: where I was is now behind them, so I go with the leader.)
    if (is_array(home) && ex > -9999 && point_distance(home[1], home[2], ex, ey) > 640)
    {
        mp_log("mirror: the scene took the party " + string(round(point_distance(home[1], home[2], ex, ey))) + " px along: I go with the leader");
        home = -1;
    }
    global.mp_mir_home = -1;
    if (is_array(home))
    {
        // Watched it: back to where I was. (The story changes it made are already here.)
        mp_log("mirror: back to where I was, " + room_get_name(home[0]));
        global.mp_warp_mus = -1;
        mp_warp(home[0], home[1], home[2], 0);
    }
    else if (rm >= 0 && mp_room_ok(rm) && !mp_credits_running())
    {
        if (mp_dz_take(edz))
            global.mp_warp_reenter = 1;
        global.mp_warp_mus = from;
        mp_warp(rm, ex, ey, 0);
    }
    else
    {
        mp_warp(room, -99999, -99999, 0);
    }
}

// At the end of a mirrored scene: [room, x, y] to go back to, or -1 to follow the leader. A scene
// that ended where it started (same room, same Light/Dark World) sends everyone back to where they
// were; one that moved the story to another place (another room, the other world, the credits)
// takes everyone along, as before.
function mp_mirror_home(rm, edz)
{
    if (!variable_global_exists("mp_mir_home"))
        return -1;
    var h = global.mp_mir_home;
    if (!is_array(h) || rm < 0 || mp_credits_running())
        return -1;
    if (rm != global.mp_mir_start_room || edz != h[3] || mp_dz() != h[3])
        return -1;
    if (!mp_room_ok(h[0]))
        return -1;
    return h;
}

function mp_mirror_recv(type, from, b)
{
    if (type >= 70 && type <= 75)
    {
        if (global.mp_sstate != 5 || from != global.mp_slead)
            return;
        var seq = buffer_read(b, buffer_u32);
        var rm = buffer_read(b, buffer_u16);
        var cx = buffer_read(b, buffer_s16);
        var cy = buffer_read(b, buffer_s16);
        var c = buffer_read(b, buffer_u8);
        var cnt = buffer_read(b, buffer_u8);
        var m = buffer_read(b, buffer_u8);
        if (c >= 6)
            return;
        var items = array_create(m);
        for (var i = 0; i < m; i++)
        {
            var spr = buffer_read(b, buffer_u16);
            var fr = buffer_read(b, buffer_u8);
            var xx = buffer_read(b, buffer_s16);
            var yy = buffer_read(b, buffer_s16);
            var xs = buffer_read(b, buffer_f32);
            var ys = buffer_read(b, buffer_f32);
            var ang = buffer_read(b, buffer_s16);
            var cr = buffer_read(b, buffer_u8);
            var cg = buffer_read(b, buffer_u8);
            var cb = buffer_read(b, buffer_u8);
            var al = buffer_read(b, buffer_u8);
            var dp = buffer_read(b, buffer_s32);
            items[i] = [spr, fr, xx, yy, xs, ys, ang, make_colour_rgb(cr, cg, cb), al / 255, dp];
            // (Test token mirfog: the one-colour silhouettes and hand-drawn hit words received.)
            if (global.mp_test != "" && (ang > 5000 || string_pos("spr_battlemsg", sprite_get_name(spr)) == 1) && mp_test_has("mirfog"))
                mp_log("mirfog: got " + sprite_get_name(spr) + (ang > 5000 ? " as a silhouette" : "") + " frame " + string(fr));
        }
        global.mp_mir_chunks[c] = [seq, items];
        var h = global.mp_mir_hdr;
        if (!is_array(h) || seq >= h[0])
            global.mp_mir_hdr = [seq, rm, cx, cy, cnt, current_time];
        // A frame is drawn only once all its parts are in. (Parts of different frames drawn together
        // showed a moving sprite twice, at its new place and an old one, when a datagram was lost or
        // late: a trail of copies of the leader, like a stretched sprite.)
        var whole = cnt >= 1 && cnt <= 6;
        for (var k = 0; k < cnt && whole; k++)
        {
            var chk = global.mp_mir_chunks[k];
            if (!is_array(chk) || chk[0] != seq)
                whole = false;
        }
        var fr0 = global.mp_mir_frame;
        if (whole && (!is_array(fr0) || seq > fr0[0]))
        {
            var all_items = [];
            for (var k2 = 0; k2 < cnt; k2++)
            {
                var its = global.mp_mir_chunks[k2][1];
                for (var j = 0; j < array_length(its); j++)
                    array_push(all_items, its[j]);
            }
            global.mp_mir_frame = [seq, rm, all_items];
        }
        return;
    }
    if (type == 76) // a sound of the leader's scene
    {
        var snd = buffer_read(b, buffer_u16);
        var vol = buffer_read(b, buffer_u8) / 100;
        var pitch = buffer_read(b, buffer_u8) / 100;
        if (global.mp_sstate != 5 || from != global.mp_slead || !audio_exists(snd))
            return;
        var s = audio_play_sound(snd, 50, false);
        if (vol != 1)
            audio_sound_gain(s, vol, 0);
        if (pitch != 1)
            audio_sound_pitch(s, pitch);
        return;
    }
    if (type == 77) // a page of the leader's next text box
    {
        var idx = buffer_read(b, buffer_u8);
        var txt = buffer_read(b, buffer_string);
        if (from == global.mp_slead && idx < 64)
            global.mp_mir_lines[idx] = txt;
        return;
    }
    if (type == 78) // ...and the box itself
    {
        var base = buffer_read(b, buffer_u16);
        var sd = buffer_read(b, buffer_u8);
        var fc = mp_rval(b);
        var fe = mp_rval(b);
        var typer = mp_rval(b);
        var nl = buffer_read(b, buffer_u8);
        if (global.mp_sstate == 5 && from == global.mp_slead)
            mp_mirror_show_dialogue(base, sd, fc, fe, typer, nl);
        return;
    }
    if (type == 79) // a follower wants the text box that's open
    {
        var who = buffer_read(b, buffer_u8);
        if (who != global.mp_myid || global.mp_sstate != 1)
            return;
        global.mp_mus_sent = ""; // and my music, again
        var w = -1;
        var sd2 = 1;
        with (obj_dialoguer)
        {
            if (instance_exists(writer))
            {
                w = writer;
                sd2 = side;
            }
        }
        if (w != -1)
            mp_mirror_send_dialogue(w, sd2);
        return;
    }
}

// Opens the leader's text box in my game (the leader turns its pages: mp_dlg_input).
function mp_mirror_show_dialogue(base, sd, fc, fe, typer, nl)
{
    with (obj_choicer_neo)
        instance_destroy();
    with (obj_writer)
        instance_destroy();
    with (obj_dialoguer)
        instance_destroy();
    with (obj_face)
        instance_destroy();
    var sf = asset_get_index("obj_smallface");
    if (sf >= 0)
    {
        with (sf)
            instance_destroy();
    }
    for (var i = 0; i < nl && i < 64; i++)
        global.msg[i] = global.mp_mir_lines[i];
    global.fc = fc;
    global.fe = fe;
    global.typer = typer;
    var d = instance_create(0, 0, obj_dialoguer);
    d.side = sd;
    global.mp_dlg_key = global.mp_slead;
    global.mp_dlg_n = base;
    global.mp_dlg_sent = -1;
    global.mp_dlg_block_since = 0;
    mp_log("mirror: text box, " + string(nl) + " pages from page " + string(base));
}

// obj_choicer_neo's Step while mirroring: show the answer the leader picked.
function mp_mirror_choice_step()
{
    if (!variable_instance_exists(id, "mp_born"))
        mp_born = current_time;
    // (The leader may have picked a moment before my choice box appeared.)
    if (canchoose == 1 && choiced == 0 && global.mp_mir_choice >= 0 && global.mp_mir_choice_t >= (mp_born - 5000))
    {
        mychoice = global.mp_mir_choice;
        global.mp_mir_choice = -1;
        event_user(0);
    }
}

// mp_sync_tick (free roam): true when the scene that was just mirrored started again here by itself,
// which is then stopped.
// A scene in parts with free play in between (Chapter 5's party jail: locked in, then talk to the
// moss): when I watched a friend play its first part, my own copy starts again as I come back. A
// hook in that scene asks this first: true means it should set itself up as the first part left it
// (in its own way) instead of playing it, where the leader stood: mp_mirror_resume_at().
function mp_mirror_resuming()
{
    if (!variable_global_exists("mp_mir_end_at") || global.mp_sstate != 0 || !is_array(global.mp_mir_end_at))
        return false;
    if (global.mp_mir_after_room != room || current_time > global.mp_mir_after_until)
        return false;
    mp_log("mirror: the scene's first part was played in a friend's game: mine takes it up from there");
    global.mp_mir_after_until = 0;
    return true;
}

// [x, y] of the leader when the part I watched ended (mp_mirror_resuming).
function mp_mirror_resume_at()
{
    return global.mp_mir_end_at;
}

function mp_mirror_after_check(ia)
{
    if (global.mp_mir_after_room != room || current_time > global.mp_mir_after_until)
        return false;
    if (global.mp_warp_pending || global.mp_warp_delay > 0 || (global.mp_frame - global.mp_lastz) <= 3)
        return false;
    // (Not "interact went up": the room's scene takes over on its first frame, while interact is
    // still up from mirroring, so it never visibly rises.)
    if (!mp_cutscene_running() && ia != 1)
        return false;
    // (Chapter 3's rhythm game: after the intro, the room's scene starts the song in my own copy,
    // as on a retry. That is the minigame, played by everyone in their own game: keep it.)
    var rg = asset_get_index("obj_rhythmgame");
    if (rg >= 0 && instance_exists(rg))
    {
        global.mp_mir_after_until = 0;
        mp_log("mirror: the room's scene starts my own copy of the rhythm game: kept");
        return false;
    }
    mp_log("mirror: the scene started again here after it ended: stopped");
    global.mp_mir_after_until = 0;
    mp_kill_scenes(true);
    mp_close_local_dialogue();
    // ...with the characters and props it had already put out, and the party it had hidden.
    var ac = asset_get_index("obj_actor");
    if (ac >= 0)
    {
        with (ac)
            instance_destroy();
    }
    with (obj_mainchara)
        visible = 1;
    with (obj_caterpillarchara)
        visible = 1;
    global.interact = 0;
    global.mp_classify = 0;
    return true;
}

// ---------------------------------------------------------------- obj_mp_mirror

function mp_mirror_obj_step()
{
    // The second drawer: the leader's sprites that are behind the room's tiles (a black cover
    // behind the floor) are drawn at the depth of the deepest of them, so the floor, and a kept
    // backdrop in front of them (scr_mp_mirror: kept scenery), show over them as in the leader's game.
    if (variable_instance_exists(id, "mp_back"))
    {
        var cut = mp_mirror_tile_cut();
        var bd = cut < 1000000000 ? cut + 1 : 1000000000;
        var fr = global.mp_mir_frame;
        if (is_array(fr))
        {
            var its = fr[2];
            for (var i = 0; i < array_length(its); i++)
            {
                if (its[i][9] > cut)
                    bd = max(bd, min(its[i][9], 1999999999));
            }
        }
        if (depth != bd)
            depth = bd;
        return;
    }
    // The middle drawers: each just behind a kept object in front of the tiles (Chapter 3's
    // spotlight, between the scene's black cover and Tenna).
    if (variable_instance_exists(id, "mp_mid"))
    {
        var sp = mp_mirror_splits();
        if (mp_mid < array_length(sp) && depth != sp[mp_mid] + 1)
            depth = sp[mp_mid] + 1;
        return;
    }
    mp_mirror_camera();
    // (Test token mirdumpall, watching: every 10 s, what is still active and showing in my game.)
    if (global.mp_test != "" && global.mp_sstate == 5 && (global.mp_frame mod 600) == 0 && mp_test_has("mirdumpall"))
    {
        var da = "";
        with (all)
        {
            if (visible && !persistent)
                da += object_get_name(object_index) + "@" + string(depth) + " ";
        }
        mp_log("mirdumpall (watching): " + da);
        mp_log("mirdumpall layers: " + mp_mirror_layer_dump());
    }
    // Under the text box (which the game draws at its own depth), over the room.
    var d = -9000;
    with (obj_dialoguer)
        d = max(d, depth + 1);
    with (obj_writer)
        d = max(d, depth + 1);
    with (obj_face)
        d = max(d, depth + 1);
    if (depth != d)
        depth = d;
}

// The depth of the room's nearest visible tile layer (1000000000 when it has none), once a room
// and again every second (a scene can show or hide one).
function mp_mirror_tile_cut()
{
    if (!variable_global_exists("mp_mir_cutroom") || global.mp_mir_cutroom != room || (global.mp_frame mod 60) == 0)
    {
        var cut = 1000000000;
        var ls = layer_get_all();
        for (var i = 0; i < array_length(ls); i++)
        {
            if (layer_get_visible(ls[i]) && layer_tilemap_get_id(ls[i]) != -1)
                cut = min(cut, layer_get_depth(ls[i]));
        }
        global.mp_mir_cut = cut;
        global.mp_mir_cutroom = room;
    }
    return global.mp_mir_cut;
}

// The depths of the kept scenery showing in front of the room's tiles, deepest first (at most
// the 3 nearest, once a frame): the mirrored sprites are drawn in parts between them, so a kept
// object shows between the leader's sprites as in the leader's game, not under them all.
function mp_mirror_splits()
{
    if (variable_global_exists("mp_mir_spf") && global.mp_mir_spf == global.mp_frame)
        return global.mp_mir_sp;
    var cut = mp_mirror_tile_cut();
    var ds = [];
    if (global.mp_sstate == 5)
    {
        for (var oi = 0; oi < array_length(global.mp_mir_keep); oi++)
        {
            with (global.mp_mir_keep[oi])
            {
                if (visible && depth <= cut)
                    array_push(ds, depth);
            }
        }
    }
    array_sort(ds, false);
    var sp = [];
    for (var i = 0; i < array_length(ds); i++)
    {
        if (array_length(sp) == 0 || sp[array_length(sp) - 1] != ds[i])
            array_push(sp, ds[i]);
    }
    if (array_length(sp) > 3)
        array_delete(sp, 0, array_length(sp) - 3);
    global.mp_mir_sp = sp;
    global.mp_mir_spf = global.mp_frame;
    return sp;
}

// kind: -1 the second drawer's pass (the sprites deeper than the room's tiles), 0-2 a middle
// drawer's (those between kept scenery), 99 the front one's (the rest).
function mp_mirror_draw(kind)
{
    var h = global.mp_mir_hdr;
    if (global.mp_sstate != 5 || !is_array(h) || h[1] != room)
        return;
    // The newest whole frame (kept while the next ones are incomplete, up to half a second).
    var fr = global.mp_mir_frame;
    if (!is_array(fr) || fr[1] != room || (h[0] - fr[0]) > 15)
        return;
    var items = fr[2];
    var n = array_length(items);
    var cut = mp_mirror_tile_cut();
    var sp = mp_mirror_splits();
    var m = array_length(sp);
    // (The depths this drawer has: deeper than lo, up to hi.)
    var lo, hi;
    if (kind == -1)
    {
        lo = cut;
        hi = infinity;
    }
    else if (kind == 99)
    {
        lo = -infinity;
        hi = m > 0 ? sp[m - 1] : cut;
    }
    else
    {
        if (kind >= m)
            return;
        lo = sp[kind];
        hi = kind == 0 ? cut : sp[kind - 1];
    }
    for (var i = 0; i < n; i++)
    {
        var it = items[i];
        if (it[9] <= lo || it[9] > hi)
            continue;
        if (!sprite_exists(it[0]))
            continue;
        if (it[6] > 5000)
        {
            gpu_set_fog(true, it[7], 0, 0);
            draw_sprite_ext(it[0], it[1], it[2], it[3], it[4], it[5], it[6] - 10000, c_white, it[8]);
            gpu_set_fog(false, c_white, 0, 0);
        }
        else
            draw_sprite_ext(it[0], it[1], it[2], it[3], it[4], it[5], it[6], it[7], it[8]);
    }
}

// The room's own layers as the leader's scene changes them: Chapter 2's ride beside Queen's car
// scrolls the road and its parked cars, which are tiles, by moving the tile layers (tilemap_x);
// many Chapter 4 and 5 scenes show or hide a layer. Only instances are in the sprite list, so the
// others' road stood still and the cars further on never came. The leader's game sends where each
// layer and its tiles are and whether it shows (message 90, every 5 frames: the layers that
// changed since, then a rotating share of the rest, so a late watcher gets them all; at most 25
// a message). The others set their own copy of the room's layers so. The room is built again
// when the scene ends.
// (Test token mirdumpall: the room's layers, name:depth:visible:x,y:old tiles.)
function mp_mirror_layer_dump()
{
    var ls = layer_get_all();
    var t = "";
    for (var i = 0; i < array_length(ls); i++)
        t += layer_get_name(ls[i]) + ":" + string(layer_get_depth(ls[i])) + ":" + string(layer_get_visible(ls[i])) + ":" + string(layer_get_x(ls[i])) + "," + string(layer_get_y(ls[i])) + ":" + string(mp_mirror_old_tiles(ls[i])) + " ";
    return t;
}

function mp_mirror_layer_state(l)
{
    var tm = layer_tilemap_get_id(l);
    var has = tm != -1;
    var hs = layer_get_hspeed(l), vs = layer_get_vspeed(l);
    // (A layer scrolling by its own speed: its place counts as changed only when its speed does,
    // and every 30 frames, so it isn't sent each time.)
    var px = layer_get_x(l), py = layer_get_y(l);
    if (hs != 0 || vs != 0)
    {
        px = (global.mp_mir_seq mod 30) == 0 ? px : -1;
        py = (global.mp_mir_seq mod 30) == 0 ? py : -1;
    }
    return [px, py, layer_get_visible(l), has, has ? tilemap_get_x(tm) : 0, has ? tilemap_get_y(tm) : 0, hs, vs, mp_mirror_old_tiles(l)];
}

// A layer's old-style tiles (tile_layer_hide hides them one by one, not the layer: Chapter 1's
// closet wall as Kris and Susie fall): -1 none, 0 all hidden, 1 some shown.
function mp_mirror_old_tiles(l)
{
    var els = layer_get_all_elements(l);
    var st = -1;
    for (var i = 0; i < array_length(els); i++)
    {
        if (layer_get_element_type(els[i]) != 7)
            continue;
        if (layer_tile_get_visible(els[i]))
            return 1;
        st = 0;
    }
    return st;
}

function mp_mirror_layers_send()
{
    if ((global.mp_mir_seq mod 5) != 0)
        return;
    var ls = layer_get_all();
    var n = array_length(ls);
    if (n == 0)
        return;
    if (!variable_global_exists("mp_mir_lsent") || global.mp_mir_lroom != room)
    {
        if (variable_global_exists("mp_mir_lsent"))
            ds_map_destroy(global.mp_mir_lsent);
        global.mp_mir_lsent = ds_map_create();
        global.mp_mir_lroom = room;
        global.mp_mir_loff = 0;
    }
    var m = global.mp_mir_lsent;
    var out = [];
    var st = array_create(n);
    for (var i = 0; i < n; i++)
    {
        st[i] = mp_mirror_layer_state(ls[i]);
        var k = string(ls[i]);
        var old = ds_map_find_value(m, k);
        if (!is_array(old) || !array_equals(old, st[i]))
            array_push(out, i);
    }
    // (A rotating share of the unchanged ones.)
    for (var j = 0; j < n && array_length(out) < 25; j++)
    {
        var i2 = (global.mp_mir_loff + j) mod n;
        var dup = false;
        for (var q = 0; q < array_length(out); q++)
        {
            if (out[q] == i2)
            {
                dup = true;
                break;
            }
        }
        if (!dup)
            array_push(out, i2);
    }
    global.mp_mir_loff = (global.mp_mir_loff + 25) mod n;
    var cnt = min(25, array_length(out));
    mp_begin(90);
    mp_wu16(room);
    mp_wu8(cnt);
    for (var c = 0; c < cnt; c++)
    {
        var li = out[c];
        var a = st[li];
        ds_map_set(m, string(ls[li]), a);
        mp_wstr(layer_get_name(ls[li]));
        buffer_write(global.mp_msg, buffer_f32, layer_get_x(ls[li]));
        buffer_write(global.mp_msg, buffer_f32, layer_get_y(ls[li]));
        buffer_write(global.mp_msg, buffer_f32, a[6]);
        buffer_write(global.mp_msg, buffer_f32, a[7]);
        mp_wu8((a[2] ? 1 : 0) | (a[3] ? 2 : 0) | (a[8] >= 0 ? 4 : 0) | (a[8] == 0 ? 8 : 0));
        if (a[3])
        {
            buffer_write(global.mp_msg, buffer_f32, a[4]);
            buffer_write(global.mp_msg, buffer_f32, a[5]);
        }
    }
    mp_send();
}

function mp_mirror_layers_recv(from, b)
{
    var rm = buffer_read(b, buffer_u16);
    var n = buffer_read(b, buffer_u8);
    var use = global.mp_sstate == 5 && from == global.mp_slead && rm == room;
    var moved = 0;
    for (var i = 0; i < n; i++)
    {
        var nm = buffer_read(b, buffer_string);
        var lx = buffer_read(b, buffer_f32);
        var ly = buffer_read(b, buffer_f32);
        var lhs = buffer_read(b, buffer_f32);
        var lvs = buffer_read(b, buffer_f32);
        var fl = buffer_read(b, buffer_u8);
        var tx = 0, ty = 0;
        if (fl & 2)
        {
            tx = buffer_read(b, buffer_f32);
            ty = buffer_read(b, buffer_f32);
        }
        if (!use)
            continue;
        var l = layer_get_id(nm);
        if (l == -1)
            continue;
        if (layer_get_hspeed(l) != lhs || layer_get_vspeed(l) != lvs)
        {
            layer_hspeed(l, lhs);
            layer_vspeed(l, lvs);
            moved++;
        }
        // (A scrolling one only when it is well off: it scrolls here by itself in between.)
        var off = max(abs(layer_get_x(l) - lx), abs(layer_get_y(l) - ly));
        if ((lhs == 0 && lvs == 0) ? off > 0 : off > (abs(lhs) + abs(lvs)) * 12)
        {
            layer_x(l, lx);
            layer_y(l, ly);
            moved++;
        }
        var vis = (fl & 1) != 0;
        if (layer_get_visible(l) != vis)
        {
            layer_set_visible(l, vis);
            moved++;
        }
        if ((fl & 4) && mp_mirror_old_tiles(l) != ((fl & 8) ? 0 : 1))
        {
            var els = layer_get_all_elements(l);
            for (var e = 0; e < array_length(els); e++)
            {
                if (layer_get_element_type(els[e]) == 7)
                    layer_tile_visible(els[e], (fl & 8) == 0);
            }
            moved++;
        }
        if (fl & 2)
        {
            var tm = layer_tilemap_get_id(l);
            if (tm != -1 && (tilemap_get_x(tm) != tx || tilemap_get_y(tm) != ty))
            {
                tilemap_x(tm, tx);
                tilemap_y(tm, ty);
                moved++;
            }
        }
    }
    if (!variable_global_exists("mp_mir_laylog"))
        global.mp_mir_laylog = 0;
    if (moved > 0 && (global.mp_mir_laylog++ mod 30) == 0)
        mp_log("mirror: " + string(moved) + " of the room's layers set as in the leader's game");
}

// ---------------------------------------------------------------- kept scenery
// Some story backdrops are objects that draw the scene's background themselves, with masks and
// blend modes the sprite list can't carry (the city behind the top of the Chapter 2 mansion, the
// giant Queen's head rising behind it, the walls rushing past as the party falls: a looping tiled
// area, which only draws). For
// the followers they stay on when their room is switched off: they draw in their game as in the
// leader's, their Step (which makes the scene's other objects) doesn't run there, and the leader
// sends their variables (message 91) so they show what the leader's show.
function mp_mirror_keep_init()
{
    global.mp_mir_keep = [];
    var names = ["obj_ch2_scene26_cityscape", "obj_ch2_scene26_gigaqueen", "obj_looping_tiled_area", "obj_anime_bg_controller", "obj_ch2_scene26_powers_combined", "obj_darkfountain", "obj_fountainkris", "obj_dw_gameshow_screen", "obj_quiz_podium", "obj_ch3_audience", "obj_ch3_GSA02_spotlight", "obj_dw_gameshow_stage_overlay", "obj_dw_tv_funometer", "obj_darkness_overlay", "obj_lightbeamfx", "obj_light_area_mask", "obj_light_following", "obj_lutshader", "obj_bg_palette_swap", "obj_fcastle_light", "obj_leafpetals", "obj_parallax_cliffs", "obj_parallax_cliffs_moving_layers", "obj_parallax_cliffs_moving_layers_back", "obj_parallax_cliffs_sunlayer", "obj_parallax_cliffs_simple"];
    for (var i = 0; i < array_length(names); i++)
    {
        var o = asset_get_index(names[i]);
        if (o >= 0)
            array_push(global.mp_mir_keep, o);
    }
    // Of those, the ones the leader's scene makes as it plays (not part of the room): the watcher
    // makes its own copy while the leader's game has one.
    global.mp_mir_made = [];
    var made = ["obj_ch2_scene26_powers_combined"];
    for (var i = 0; i < array_length(made); i++)
    {
        var o = asset_get_index(made[i]);
        if (o >= 0)
            array_push(global.mp_mir_made, o);
    }
    // And the ones drawn over another kept one at the same depth in the leader's game (the order of
    // equal depths is the engine's own, not the same in every game): a step nearer here. Chapter 3's
    // stage overlay darkens the floor over the TV screen's star background, both at 990000.
    global.mp_mir_front = [];
    var front = ["obj_dw_gameshow_stage_overlay"];
    for (var i = 0; i < array_length(front); i++)
    {
        var o = asset_get_index(front[i]);
        if (o >= 0)
            array_push(global.mp_mir_front, o);
    }
    global.mp_mir_fogobj = asset_get_index("obj_marker_fog");
    global.mp_mir_fogobj2 = asset_get_index("obj_marker_fogblend");
    global.mp_mir_ksent = ds_map_create();
    global.mp_mir_kroom = -1;
    global.mp_mir_koff = 0;
}

function mp_mirror_kept(obj)
{
    if (!variable_global_exists("mp_mir_keep"))
        return false;
    for (var i = 0; i < array_length(global.mp_mir_keep); i++)
    {
        if (global.mp_mir_keep[i] == obj)
            return true;
    }
    return false;
}

function mp_mirror_is_made(obj)
{
    for (var i = 0; i < array_length(global.mp_mir_made); i++)
    {
        if (global.mp_mir_made[i] == obj)
            return true;
    }
    return false;
}

// Prepended to a kept object's Step: not while I watch (the leader's game runs it).
function mp_mirror_kept_paused()
{
    return variable_global_exists("mp_inited") && mp_on() && global.mp_sstate == 5;
}

// In snd_play: a kept object's sounds come from the leader's game while I watch (message 76).
function mp_mirror_kept_quiet()
{
    return variable_global_exists("mp_mir_keep") && mp_on() && global.mp_sstate == 5 && mp_mirror_kept(object_index);
}

// Whether a variable's name says it holds a resource of the game's own (a surface, a list...).
function mp_mirror_own_res(nm)
{
    var l = string_lower(nm);
    return string_pos("surf", l) > 0 || string_pos("_list", l) > 0 || string_pos("_map", l) > 0 || string_pos("grid", l) > 0 || string_pos("buffer", l) > 0 || string_pos("part_", l) > 0 || string_pos("shader", l) > 0;
}

// mp_mirror_lead_tick: the kept objects' variables, the changed ones and a rotating share.
function mp_mirror_keep_send()
{
    if ((global.mp_mir_seq mod 3) != 0 || array_length(global.mp_mir_keep) == 0)
        return;
    if (global.mp_mir_kroom != room)
    {
        ds_map_clear(global.mp_mir_ksent);
        global.mp_mir_kroom = room;
    }
    var m = global.mp_mir_ksent;
    var chg = [], rest = [];
    for (var oi = 0; oi < array_length(global.mp_mir_keep); oi++)
    {
        var obj = global.mp_mir_keep[oi];
        // (How many the leader's scene has made, first: the watcher makes or removes its copies.)
        if (mp_mirror_is_made(obj))
        {
            var cn = min(instance_number(obj), 8);
            var ck = string(obj) + ":0:#n";
            if (ds_map_find_value(m, ck) != cn)
                array_push(chg, [obj, 0, "#n", cn]);
            else
                array_push(rest, [obj, 0, "#n", cn]);
        }
        for (var k = 0; k < instance_number(obj) && k < 8; k++)
        {
            var inst = instance_find(obj, k);
            var nms = variable_instance_get_names(inst);
            // (Its place and look too, as "@" names.)
            var bn = ["@x", "@y", "@depth", "@sprite_index", "@image_index", "@image_alpha", "@image_blend", "@image_xscale", "@image_yscale", "@image_angle", "@visible"];
            var bv = [inst.x, inst.y, inst.depth, inst.sprite_index, inst.image_index, inst.image_alpha, inst.image_blend, inst.image_xscale, inst.image_yscale, inst.image_angle, inst.visible];
            for (var q = 0; q < array_length(bn); q++)
            {
                var bk = string(obj) + ":" + string(k) + ":" + bn[q];
                if (ds_map_find_value(m, bk) != real(bv[q]))
                    array_push(chg, [obj, k, bn[q], real(bv[q])]);
                else
                    array_push(rest, [obj, k, bn[q], real(bv[q])]);
            }
            for (var v = 0; v < array_length(nms); v++)
            {
                // (Not a surface or a data structure of its own: each game keeps its own, and the
                // leader's id means something else here. Chapter 4's darkness keeps its surfaces.)
                if (mp_mirror_own_res(nms[v]))
                    continue;
                var val = variable_instance_get(inst, nms[v]);
                // (Small arrays element by element, as "name[i]": Chapter 3's podium letters.)
                var vals = [val], vn = [nms[v]];
                if (is_array(val))
                {
                    if (array_length(val) > 8)
                        continue;
                    vals = val;
                    vn = [];
                    for (var ai = 0; ai < array_length(val); ai++)
                        vn[ai] = nms[v] + "[" + string(ai) + "]";
                }
                for (var ai = 0; ai < array_length(vals); ai++)
                {
                    var one = vals[ai];
                    var nm1 = vn[ai];
                    // (Text as "$" names: Chapter 3's TV screen shows what its screen_state says.)
                    if (is_string(one))
                    {
                        if (string_length(one) > 60)
                            continue;
                        nm1 = "$" + nm1;
                    }
                    else if (is_real(one) || is_bool(one) || is_int32(one) || is_int64(one))
                    {
                        one = real(one);
                        // (Not the ids of objects it made, which are the leader's own: "none" there.)
                        // (Nor one of another kept object, which the watcher has its own of: Chapter
                        // 5's sky layers point at their parallax backdrop.)
                        if (one >= 100000 && instance_exists(one))
                        {
                            if (mp_mirror_kept(one.object_index))
                                continue;
                            one = noone;
                        }
                    }
                    else
                        continue;
                    var e = [obj, k, nm1, one];
                    var key = string(obj) + ":" + string(k) + ":" + nm1;
                    if (ds_map_find_value(m, key) != one)
                        array_push(chg, e);
                    else
                        array_push(rest, e);
                }
            }
        }
    }
    // (The unchanged ones a few at a time, twice a second: for a datagram that got lost.)
    var out = chg;
    var nr = array_length(rest);
    if ((global.mp_mir_seq mod 15) == 0)
    {
        for (var j = 0; j < nr && j < 12; j++)
            array_push(out, rest[(global.mp_mir_koff + j) mod nr]);
        global.mp_mir_koff += 12;
    }
    var cnt = min(40, array_length(out));
    if (cnt == 0)
        return;
    mp_begin(91);
    mp_wu16(room);
    mp_wu8(cnt);
    for (var c = 0; c < cnt; c++)
    {
        var a = out[c];
        ds_map_set(m, string(a[0]) + ":" + string(a[1]) + ":" + a[2], a[3]);
        mp_wu16(a[0]);
        mp_wu8(a[1]);
        mp_wstr(a[2]);
        if (string_char_at(a[2], 1) == "$")
            mp_wstr(a[3]);
        else
            buffer_write(global.mp_msg, buffer_f64, a[3]);
    }
    mp_send();
}

function mp_mirror_keep_recv(from, b)
{
    var rm = buffer_read(b, buffer_u16);
    var n = buffer_read(b, buffer_u8);
    var use = global.mp_sstate == 5 && from == global.mp_slead && rm == room;
    var set = 0;
    for (var i = 0; i < n; i++)
    {
        var obj = buffer_read(b, buffer_u16);
        var k = buffer_read(b, buffer_u8);
        var nm = buffer_read(b, buffer_string);
        var val;
        if (string_char_at(nm, 1) == "$")
        {
            val = buffer_read(b, buffer_string);
            nm = string_delete(nm, 1, 1);
        }
        else
            val = buffer_read(b, buffer_f64);
        if (!use || !mp_mirror_kept(obj))
            continue;
        if (nm == "#n")
        {
            if (mp_mirror_is_made(obj))
                set += mp_mirror_made_count(obj, val);
            continue;
        }
        if (k >= instance_number(obj))
            continue;
        var inst = instance_find(obj, k);
        if (string_char_at(nm, 1) == "@")
        {
            set += mp_mirror_set_builtin(inst, nm, val);
            continue;
        }
        var bp = string_pos("[", nm);
        if (bp > 0)
        {
            // (An element of one of its arrays: only into an array it has.)
            var arr = variable_instance_get(inst, string_copy(nm, 1, bp - 1));
            var ai = real(string_copy(nm, bp + 1, string_length(nm) - bp - 1));
            if (is_array(arr) && ai < array_length(arr) && (is_string(arr[ai]) != is_string(val) || arr[ai] != val))
            {
                arr[@ ai] = val;
                set++;
            }
            continue;
        }
        var cur = variable_instance_get(inst, nm);
        if (is_string(cur) != is_string(val) || cur != val)
        {
            variable_instance_set(inst, nm, val);
            set++;
        }
    }
    if (set > 0 && global.mp_frame >= global.mp_mir_klog)
    {
        global.mp_mir_klog = global.mp_frame + 120;
        mp_log("mirror: " + string(set) + " values of the scene's backdrop set as in the leader's game");
    }
}

// The watcher's copies of a made backdrop object: as many as the leader's game has.
function mp_mirror_made_count(obj, n)
{
    var did = 0;
    while (instance_number(obj) < n)
    {
        var c = instance_create_depth(camerax(), cameray(), 0, obj);
        c.mp_mir_copy = true;
        did++;
        mp_log("mirror: made a copy of the leader's " + object_get_name(obj));
    }
    while (instance_number(obj) > n)
    {
        // (Without its Destroy event: what that makes is the leader's scene's.)
        instance_destroy(instance_find(obj, instance_number(obj) - 1), false);
        did++;
        mp_log("mirror: removed a copy of " + object_get_name(obj));
    }
    return did;
}

// A kept object's place and look, as in the leader's game ("@" names in message 91).
function mp_mirror_set_builtin(inst, nm, v)
{
    var did = 0;
    with (inst)
    {
        switch (nm)
        {
            case "@x": if (x != v) { x = v; did = 1; } break;
            case "@y": if (y != v) { y = v; did = 1; } break;
            case "@depth":
                var dv = v;
                for (var fi = 0; fi < array_length(global.mp_mir_front); fi++)
                {
                    if (global.mp_mir_front[fi] == object_index)
                        dv = v - 1;
                }
                if (depth != dv) { depth = dv; did = 1; }
                break;
            case "@sprite_index": if (sprite_index != v && sprite_exists(v)) { sprite_index = v; did = 1; } break;
            case "@image_index": if (image_index != v) { image_index = v; did = 1; } break;
            case "@image_alpha": if (image_alpha != v) { image_alpha = v; did = 1; } break;
            case "@image_blend": if (image_blend != v) { image_blend = v; did = 1; } break;
            case "@image_xscale": if (image_xscale != v) { image_xscale = v; did = 1; } break;
            case "@image_yscale": if (image_yscale != v) { image_yscale = v; did = 1; } break;
            case "@image_angle": if (image_angle != v) { image_angle = v; did = 1; } break;
            case "@visible": if (visible != v) { visible = v; did = 1; } break;
        }
    }
    return did;
}

// In place of draw_sprite_ext in the Draw of a scene's object that draws its sprites by hand (the
// Chapter 2 coaster ride with everyone on it): it draws as before, and in the leader's game the
// sprite also goes in the list the watchers draw (mp_mirror_lead_tick), at the object's depth.
function mp_mir_dse(spr, img, xx, yy, xs, ys, ang, col, al)
{
    draw_sprite_ext(spr, img, xx, yy, xs, ys, ang, col, al);
    mp_mir_hand = true;
    if (mp_mir_recording())
        array_push(global.mp_mir_extra, [depth, spr, img < 0 ? image_index : img, xx, yy, xs, ys, ang, col, al]);
}

// The same for draw_self.
function mp_mir_dself()
{
    draw_self();
    mp_mir_hand = true;
    if (sprite_index >= 0 && mp_mir_recording())
        array_push(global.mp_mir_extra, [depth, sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha]);
}

// The same for draw_sprite.
function mp_mir_ds(spr, img, xx, yy)
{
    draw_sprite(spr, img, xx, yy);
    mp_mir_hand = true;
    if (mp_mir_recording())
        array_push(global.mp_mir_extra, [depth, spr, img < 0 ? image_index : img, xx, yy, 1, 1, 0, c_white, draw_get_alpha()]);
}

// Whether what the calling instance draws by hand goes to the watchers now: in my shared cutscene,
// not a persistent object or kept scenery (those draw in the watchers' games themselves), not
// drawn into a surface of its own (another place), and at most 200 a frame.
function mp_mir_recording()
{
    if (!variable_global_exists("mp_mir_extra") || global.mp_sstate != 1 || !mp_on() || persistent)
        return false;
    if (array_length(global.mp_mir_extra) >= 200 || mp_mirror_kept(object_index))
        return false;
    var t = surface_get_target();
    return t == -1 || t == application_surface;
}

// The same for a filled rectangle (a flash, a fade over the screen, the light of a sealed fountain):
// it goes as a stretched white pixel in the draw colour and alpha.
function mp_mir_drect(x1, y1, x2, y2, outline)
{
    draw_rectangle(x1, y1, x2, y2, outline);
    mp_mir_hand = true;
    if (!outline && global.mp_mir_pix >= 0 && mp_mir_recording())
    {
        array_push(global.mp_mir_extra, [depth, global.mp_mir_pix, 0, min(x1, x2), min(y1, y2), (abs(x2 - x1) + 1) / sprite_get_width(global.mp_mir_pix), (abs(y2 - y1) + 1) / sprite_get_height(global.mp_mir_pix), 0, draw_get_colour(), draw_get_alpha()]);
    }
}

// The same for a thick line (Chapter 5's red threads in Asgore's flashback): a white pixel
// stretched along it, as thick as the line, turned to its direction, in its colour.
function mp_mir_dline(x1, y1, x2, y2, w, c1, c2)
{
    draw_line_width_color(x1, y1, x2, y2, w, c1, c2);
    mp_mir_hand = true;
    if (global.mp_mir_pix >= 0 && mp_mir_recording())
    {
        var ang = point_direction(x1, y1, x2, y2);
        var sx = x1 - lengthdir_x(w / 2, ang - 90);
        var sy = y1 - lengthdir_y(w / 2, ang - 90);
        array_push(global.mp_mir_extra, [depth, global.mp_mir_pix, 0, sx, sy, point_distance(x1, y1, x2, y2) / sprite_get_width(global.mp_mir_pix), w / sprite_get_height(global.mp_mir_pix), ang, c1, draw_get_alpha()]);
    }
}

// In place of audio_play_sound in such an object: the watchers hear it too (message 76, as snd_play).
function mp_mir_aps(snd, pri, loop)
{
    var r = audio_play_sound(snd, pri, loop);
    if (!loop && variable_global_exists("mp_inited"))
        mp_mirror_snd(snd, 1, 1);
    return r;
}
